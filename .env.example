# cp .env.example .env и заполнить. Всё, кроме ключей, имеет рабочие дефолты.

# --- обязательное ---
BOT_TOKEN=                      # у @BotFather
OPENAI_API_KEY=                 # стилизация фото; или выключи AI_STYLIZE_ENABLED
GEMINI_API_KEY=                 # тюркизация имён

# Кому доступны /stats, /reset, /ai. Через запятую. Свой id — команда /whoami.
ADMIN_IDS=

# --- модели ---
# Пиним на версии: алиас *-latest молча переедет и утащит цену и поведение.
OPENAI_IMAGE_MODEL=gpt-image-2
GEMINI_TEXT_MODEL=gemini-3.6-flash

# --- поведение на стенде ---
PASSPORT_LIMIT_PER_USER=1       # считается по УСПЕШНЫМ выдачам, не по попыткам
AI_STYLIZE_ENABLED=true         # выключатель на время работы — команда /ai off
AI_MAX_RETRIES=3
NAME_CACHE_ENABLED=true

# Дневной потолок стилизаций. Уперлись — бот уходит на локальную сепию,
# но паспорта выдавать не перестаёт.
DAILY_AI_BUDGET=1200

# Сколько стилизаций крутится параллельно. Упрёмся в rate limit провайдера,
# а не в железо.
STYLIZE_CONCURRENCY=4

DEFAULT_LANG=ru
DB_PATH=data/comicon.db

# Копия каждого выданного паспорта в личку каждому из ADMIN_IDS, документом
# (исходный PNG, не пережатое превью). Пустой ADMIN_IDS выключает сам собой.
ADMIN_COPY_ENABLED=true

# --- печатный разворот ---
# Второй шаг, невидимый гостю: из готовой 16:9 собирается вертикальный лист
# 125×176 мм под паспорт-холдер и уходит документом оператору печати.
# Делается ТОЛЬКО для гостей, ответивших «другая страна» на вопрос о
# гражданстве. Пусто = ветка выключена совсем, все получают только 16:9.
#
# Лучше закрытый канал (бот — админ, id вида -1001234567890), а не личка:
# фото гостей лежат отдельно и удаляются вместе с каналом после стенда.
PRINT_USER_CHAT_ID=
PRINT_ENABLED=true

# gpt-image-2 берёт любой размер: стороны кратны 16, длинная ≤ 3840,
# не круче 3:1, 0.65–8.3 Мп. 1744x2336 — то 3:4, на котором проверяли промпт;
# 1472x2080 почти точный печатный лист и на четверть дешевле по токенам.
PRINT_IMAGE_SIZE=1744x2336

PRINT_CONCURRENCY=2             # своя очередь, чтобы не отъедать rate limit
PRINT_MAX_RETRIES=3
PRINT_QC_ENABLED=true           # проверка «животное не осталось в документе»
PRINT_BLEED=false               # вторым файлом версию с вылетами под типографию

# Тюркизация имён. 429 у Gemini бывает минутный (RPM, проходит за секунды) и
# суточный (RPD, до завтра). Ретраи вытаскивают первый; второй лечится только
# платным тарифом, до тех пор имена идут из запасного списка.
NAME_MAX_RETRIES=2
NAME_CONCURRENCY=4
